// note: const before std::vector<double>
// and the & afterwards

int min_vector_element(const std::vector<double>& vin){

    double min = 99999999;
    int idx =-1;


    for(int i = 0; i < vin.size(); i++){
       if (vin[i]<min){
        min = vin[i];
        idx=i;
       }
    }

    return idx;

}

int main(){
    std::vector<double> v;
    int n =0;
    int sub = 0;
    cin >> n;
    for (int  i=0; i<n;i++){
        cin>> sub;
    v.push_back(sub);
    }

    v.push_back(3);
    v.push_back(0.5);
    v.push_back(-1);

    std::cout << "the min is: " << min_vector_element(v) << std::endl;

}
